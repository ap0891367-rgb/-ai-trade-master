# --- Database ---------------------------------------------------------------
# Local Postgres (docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Force TLS on/off for hosted Postgres. Leave unset for auto-detection.
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10

# --- Auth -------------------------------------------------------------------
# Long random string (>= 32 chars). Used to sign session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret

# Secret required by POST /api/setup to run the one-time database seed.
SETUP_SECRET=replace-with-a-setup-secret

# --- Bootstrap accounts (used only by the seeder) ---------------------------
ADMIN_EMAIL=admin@autotrading.ai
ADMIN_PASSWORD=replace-this-admin-password
DEMO_PASSWORD=demo1234

# Set to "false" to disable the 1-click demo trader login.
DEMO_LOGIN_ENABLED=true

# Session cookie Secure flag. Defaults to on in production. Set to "false"
# only when serving over plain HTTP (e.g. a local production build).
# AUTH_COOKIE_SECURE=false
